{
  "conversationId": "real-project-task",
  "fromUserId": "u-owner",
  "projectId": "wechat",
  "turns": [
    {
      "content": "/project wfxm",
      "expect": { "route": "rule", "rule": "project", "mustContain": ["已切换到项目"] }
    },
    {
      "content": "/new 列出 packages/runtime/src/butler 目录下的文件名，最多 5 个",
      "expect": { "route": "rule", "rule": "new" }
    },
    { "waitMs": 90000 },
    {
      "content": "/status {{taskId}}",
      "expect": {
        "route": "rule",
        "rule": "status",
        "mustNotContain": ["没有找到任务", "ENOENT", "不存在"]
      }
    }
  ]
}
