# butler-v5-gateway.service: systemd user unit template for v5 butler wiring.
#
# R10.3 simplified cutover. Replaces v4's butler-gateway.service when
# v5 is acceptable.
#
# To enable (operator step):
#   1. Save this file at: ~/.config/systemd/user/butler-v5-gateway.service
#   2. systemctl --user daemon-reload
#   3. systemctl --user enable --now butler-v5-gateway.service
#   4. systemctl --user status butler-v5-gateway.service
#
# WeChat: set BUTLER_V5_ILINK_ENABLED=1 plus WECHAT_TOKEN (and usually
# WECHAT_ACCOUNT_ID / WECHAT_BASE_URL) in EnvironmentFile. The poller
# starts after Hono listens. QR login is still out of scope — reuse the
# token from wechat-setup / existing env. Mock: openclaw-mock.mjs :9999.

[Unit]
Description=Butler v5 Wiring (Hono API on port 3000, replaces v4 butler-gateway)
Documentation=https://github.com/XiaZiHunDun/WFXM
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/home/ailearn/projects/WFXM/butler-v5
ExecStartPre=-/usr/bin/docker compose -f /home/ailearn/projects/WFXM/butler-v5/docker-compose.yml up -d postgres wechat-mock
ExecStart=/home/ailearn/.local/bin/butler-v5-start.sh
ExecStop=/bin/bash -c '/usr/bin/pkill -TERM -f "cli/src/index.ts start" || true; sleep 2; /usr/bin/pkill -KILL -f "cli/src/index.ts start" || true'
KillMode=control-group
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# Environment
Environment=PORT=3000
Environment=NODE_ENV=production
# LLM provider env（owner 设置在本地 live service file，本模板不带 key）
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
# NO_PROXY=api.deepseek.com,api.openai.com,dashscope.aliyuncs.com,api.minimaxi.com
Environment=PATH=/home/ailearn/.nvm/versions/node/v20.20.1/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/butler-v5/env
# When BUTLER_V5_SANDBOX=bubblewrap, butler-v5-start.sh runs sandbox-preflight (fail-closed).
# Optional duplicate guard for systemd:
# ExecStartPre=/home/ailearn/projects/WFXM/butler-v5/scripts/cutover/butler-v5-sandbox-preflight.sh

[Install]
WantedBy=default.target
