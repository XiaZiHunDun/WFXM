      "tools": [
        {
          "name": "convert_to_markdown",
          "description": "Convert office/PDF documents to Markdown",
          "risk": "low"
        }
      ]
    },
    {
      "id": "firecrawl",
      "transport": "stdio",
      "command": "/home/ailearn/projects/WFXM/butler-v5/node_modules/.bin/firecrawl-mcp",
      "tools": [
        { "name": "firecrawl_scrape", "risk": "low" },
        { "name": "firecrawl_crawl", "risk": "low" },
        { "name": "firecrawl_map", "risk": "low" }
      ]
    },
    {
      "id": "github",
      "transport": "stdio",
