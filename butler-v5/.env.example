# Butler v5 Environment Variables
# Copy to .env and customize

# ─── Loop 配置 ─────────────────────────────────────────
LOOP_MAX_ITERATIONS=50
LOOP_TIMEOUT_MS=600000

# ─── Guard 配置 ────────────────────────────────────────
GUARDS_OWNER_OFFLINE_THRESHOLD_MS=300000
GUARDS_CHAOS_ENABLED=false

# ─── LLM 配置 ──────────────────────────────────────────
LLM_PRIMARY=anthropic
LLM_FALLBACK=openai
# Model router (WeChat plan vs subagent exec vs intake):
# Production default (2026-08-26): deepseek-v4-flash (V4 Flash stable API id).
# Legacy deepseek-chat aliases V4 non-thinking mode until provider retires it.
# BUTLER_V5_MODEL_PLAN=deepseek-v4-flash
# BUTLER_V5_MODEL_EXEC=MiniMax-M3
# BUTLER_V5_MODEL_INTAKE=deepseek-v4-flash
# DeepSeek V4 thinking mode (default disabled for plan/intake JSON routing):
# BUTLER_V5_DEEPSEEK_THINKING=disabled
# MINIMAX_API_KEY=          # 国际区 Subscription Key → api.minimax.io
# MINIMAX_CN_API_KEY=       # 国内区 Key → api.minimaxi.com（与 MINIMAX_API_KEY 二选一）
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ─── WeChat Intake / Dev Session (P0–P2) ───────────────
# Intent routing before main loop (default on). Set 0 to disable.
# BUTLER_V5_INTAKE_ENABLED=1
# Optional Flash LLM intent (default off; rules first):
# BUTLER_V5_INTAKE_LLM=0
# Dev session batch-grant run_command + write_file (minutes / max uses):
# BUTLER_V5_DEV_SESSION_GRANT_MINUTES=30
# BUTLER_V5_DEV_SESSION_MAX_USES=50
# After exec approval, skip post-loop re-Ask (default off). Set 1 to restore old loop:
# BUTLER_V5_POST_APPROVAL_LOOP=0
# Project dev state JSON (~/.config/butler-v5/project-state.json):
# BUTLER_V5_PROJECT_STATE_STORE=
# P4: auto verify after dev_task / exec subagent (default on):
# BUTLER_V5_DEV_VERIFY_ENABLED=1
# BUTLER_V5_DEV_VERIFY_CMD=pnpm test
# BUTLER_V5_DEV_VERIFY_CMD=["pnpm","exec","vitest","run","apps/api/src/dev-quality-gate.test.ts"]
# BUTLER_V5_DEV_VERIFY_TIMEOUT_MS=300000
# BUTLER_V5_DEV_VERIFY_INLINE=0
# Scheme B (default): dev_task → plan Loop + delegate_to_subagent → Child Run (MiniMax).
# Legacy opt-in: main Loop direct write/run (hides delegate):
# BUTLER_V5_DEV_DIRECT_EXEC=0
# Deprecated alias: BUTLER_V5_DEV_PREFER_DELEGATE (inverse of direct exec)
# Working-set budget (relational read model; dev tasks use larger window):
# BUTLER_V5_WORKING_SET_MAX_MESSAGES=12
# BUTLER_V5_WORKING_SET_MAX_CHARS=4000
# BUTLER_V5_DEV_WORKING_SET_MAX_MESSAGES=20
# BUTLER_V5_DEV_WORKING_SET_MAX_CHARS=8000
# Loopback smoke: pnpm smoke:dev-tools
# T3 LLM fixture (zero external API in CI): gateway must set
# BUTLER_V5_LLM_FIXTURE_DIR=config/llm-fixtures/wechat
# BUTLER_V5_RUN_NOTIFY_MOCK_OUTBOX=/tmp/butler-v5-ci-notify.jsonl

# ─── 数据库 ────────────────────────────────────────────
# Production (`NODE_ENV=production` + DATABASE_URL) uses Docker Postgres so
# conversation / Run state survives gateway restart — required for long sessions
# and multi-project workloads. Tests use in-process PGlite. Override:
# BUTLER_V5_DB=pglite | postgres
# Local PGlite persistence (non-test): default ~/.butler/v5-data; override or use memory:
# BUTLER_V5_PGLITE_DATA_DIR=memory
# BUTLER_V5_PGLITE_DATA_DIR=~/.butler/v5-data
DATABASE_URL=postgres://butler:butler_dev@localhost:5432/butler_v5
# BUTLER_V5_DB=postgres
DB_MAX_CONNECTIONS=10

# ─── Target runtime / governance ───────────────────────
# Read model: event_store | hybrid | relational (default relational — 0002 messages)
# Use hybrid only when migrating legacy event_store-only streams.
# BUTLER_V5_READ_MODEL=relational
# Owner API (/v1/owner/*) accepts loopback clients only — no bearer token.

# ─── Subagent / WS push (opt-in background delegate) ───
# Off by default. When 1: starts WS on loopback (WS_PORT default 3001) + outbox worker,
# and exposes delegate_to_subagent to the butler loop.
# BUTLER_V5_SUBAGENT_ENABLED=0
# Subagent JSONL audit (default ~/.config/butler-v5/audit/subagent.jsonl)
# BUTLER_V5_SUBAGENT_AUDIT_PATH=
# Proactive WeChat push when subagent / long run completes (requires iLink)
# BUTLER_V5_RUN_NOTIFY_ENABLED=0
# /运行 async + push on completion (default on when RUN_NOTIFY=1)
# BUTLER_V5_TASK_RUN_ASYNC=0
# Loopback acceptance mock outbox (omit when using real iLink push only)
# BUTLER_V5_RUN_NOTIFY_MOCK_OUTBOX=/tmp/butler-v5-notify-acceptance.jsonl
# Optional real outbound probe: BUTLER_V5_ILINK_PING_TO=<wechat_user_id>
#   bash scripts/cutover/configure-ilink-ping.sh <wechat_user_id>
# Verification: docs/plans/active/v5-verification-strategy-2026-08.md
#   pnpm smoke:regression | smoke:regression:quick | smoke:ci-regression | smoke:ilink
# WeChat slash: /委派 <任务> · /委派状态
# Enable script: scripts/cutover/enable-subagent-prod.sh
# WS_PORT=3001
# WS_HOST=127.0.0.1

# Sandbox for run_command: unset | bubblewrap (fail-closed when bwrap missing)
# BUTLER_V5_SANDBOX=bubblewrap
# Grant.sandboxProfile: approve run_command/mcp_* stamps workspace-write-network-deny;
# Owner POST .../approve { "elevateNetwork": true } → workspace-write-network-allow
# Owner POST .../approve { "networkAllowlist": ["registry.npmjs.org:443"] }
#   → workspace-write-network-allowlist (P2b; execution filter in P2c/d)
# BUTLER_V5_SANDBOX_ALLOW_PRIVATE_EGRESS=0
# BUTLER_V5_SANDBOX_NETWORK_MODE=binary
# Set allowlist to enable P2c egress proxy for workspace-write-network-allowlist Grants:
# BUTLER_V5_SANDBOX_NETWORK_MODE=allowlist
# P2d hard isolation (opt-in; requires slirp4netns + rootless unshare):
# BUTLER_V5_SANDBOX_EGRESS_ISOLATION=slirp
# When slirp fails, retry P2c proxy path (default 1 in prod-tune):
# BUTLER_V5_SANDBOX_SLIRP_FALLBACK=1
# run_command under slirp defaults to 120s (override with BUTLER_V5_RUN_COMMAND_TIMEOUT_MS)
# BUTLER_V5_RUN_COMMAND_TIMEOUT_MS=120000
# Optional when host egress requires system proxy (e.g. mihomo):
# BUTLER_V5_SANDBOX_EGRESS_UPSTREAM_PROXY=http://127.0.0.1:7890
# P2 磁盘配额：bubblewrap 沙箱子进程单文件大小上限（字节；prlimit --fsize 实现）。
# /tmp 在沙箱内已是 tmpfs（内存态，不会撑满宿主盘），该 RLIMIT 封顶沙箱内任意写入的单文件大小。
# BUTLER_V5_SANDBOX_MAX_FILE_BYTES=8388608

# ─── P2 全局硬停 ───────────────────────────────────────
# Per-LLM-call timeout in conversation-loop (Phase D eval fix B-09). Default 30000ms.
# BUTLER_V5_LLM_TIMEOUT_MS=30000
# Stuck-loop threshold (Phase D eval fix B-06). If LLM invokes same capability
# with same args >= this many times in one loop run, short-circuit with Finish.
# BUTLER_V5_STUCK_LOOP_THRESHOLD=3
# 设为 1 时，所有副作用（write/command/outbound/delegate）无论有无 Grant 一律 Deny（fail-closed）；
# 只读能力（read）与模型调用（model）不受影响。用于紧急停机。
# BUTLER_V5_KILL_SWITCH=0

# ─── MCP (opt-in, default off) ─────────────────────────
# BUTLER_V5_MCP_ENABLED=0
# Stub tool names when no MCP server URL wired yet (comma-separated)
# BUTLER_V5_MCP_TOOL_NAMES=search,fetch
# BUTLER_V5_MCP_URL=http://127.0.0.1:7777/mcp
# BUTLER_V5_MCP_TOKEN=
# BUTLER_V5_MCP_TIMEOUT_MS=30000
# BUTLER_V5_MCP_REQUIRED=0
# BUTLER_V5_MCP_REQUIRE_CONSENT=0
# BUTLER_V5_MCP_CONSENT=
# BUTLER_V5_MCP_SERVER_ID=
# BUTLER_V5_MCP_MANIFEST_PATH=config/mcp-manifest.json
# Owner low-risk MCP (manifest risk=low) skip per-call Ask when 1
# BUTLER_V5_MCP_READONLY_AUTO_ALLOW=0
# Stdio MCP outbound hosts auto-stamped on Grant (todoist/firecrawl/github); optional extras:
# BUTLER_V5_GRANT_NETWORK_HOSTS=

# BUTLER_V5_MCP_TRANSPORT=http
# BUTLER_V5_MCP_COMMAND=node
# BUTLER_V5_MCP_ARGS=path/to/mcp-server.js
# WeChat loop MCP subset (opt-in): core tools + per-project mcpTools in JSON
# BUTLER_V5_WECHAT_TOOL_ALLOWLIST_PATH=config/wechat-tool-allowlist.json
# Enable script: scripts/cutover/enable-mcp-prod.sh
# Smoke: pnpm smoke:mcp  (pnpm smoke:mcp -- --skip-grant for config-only)
# Project Knowledge working-set inject (opt-in; default off)
# BUTLER_V5_PROJECT_KNOWLEDGE=0
# Project Knowledge sources watch (opt-in; default off)
# BUTLER_V5_PROJECT_KNOWLEDGE_WATCH=0
# BUTLER_V5_PROJECT_KNOWLEDGE_SOURCES_PATH=config/project-knowledge-sources.json
# BUTLER_V5_PROJECT_KNOWLEDGE_INBOUND_MAP=wechat:WFXM,LingWen1:LingWen,灵文1号:LingWen
# BUTLER_V5_PROJECT_KNOWLEDGE_WATCH_MS=300000

# ─── Generic channel intake (opt-in second channel seam) ─
# BUTLER_V5_CHANNEL_API_ENABLED=0
# BUTLER_V5_CHANNEL_ALLOWLIST=slack,telegram,api
# BUTLER_V5_SLACK_ENABLED=0
# BUTLER_V5_SLACK_SIGNING_SECRET=
# BUTLER_V5_SLACK_BOT_TOKEN=
# BUTLER_V5_TELEGRAM_ENABLED=0
# BUTLER_V5_TELEGRAM_WEBHOOK_SECRET=
# BUTLER_V5_TELEGRAM_BOT_TOKEN=
# BUTLER_V5_TELEGRAM_MEDIA_CACHE=0
# BUTLER_V5_TELEGRAM_MEDIA_DIR=
# BUTLER_V5_TELEGRAM_MEDIA_MAX_BYTES=8388608
# BUTLER_V5_CHANNEL_OUTBOUND_MEDIA=0

# ─── Schedule / Heartbeat (opt-in RunTrigger) ───────────
# Off by default. Produces source=schedule Triggers; no second engine.
# BUTLER_V5_SCHEDULE_ENABLED=0
# BUTLER_V5_SCHEDULE_TICK_MS=60000
# BUTLER_V5_SCHEDULE_JOBS_PATH=config/schedule-jobs.json
# Inline JSON alternative (wins over path when set):
# BUTLER_V5_SCHEDULE_JOBS=[{"id":"hourly-heartbeat","everyMs":3600000,"goal":"只读巡检","cooldownMs":3600000,"maxSteps":3,"deadlineMs":120000,"quietSuccess":true,"enabled":true}]
# When 1, defer fires if isMainQueueBusy hook reports busy (API can wire later).
# BUTLER_V5_SCHEDULE_DEFER_WHEN_BUSY=0

# ─── Durable Memory (layer 2 knowledge, opt-in inject) ─
# Table always migrated; Owner API CRUD always available with token.
# Set 1 to inject confirmed memories into the model working set.
# BUTLER_V5_DURABLE_MEMORY=0
# CLI: butler memory list|add|confirm|reject|delete

# ─── Document ingest (named formats; not RAG Studio) ───
# Formats: plaintext | markdown | pdf (pdf requires pre-extracted text)
# CLI: butler document list|add|get|delete|promote
# Example: butler document add "手册" --format markdown --file ./notes.md

# ─── Local tracing / optional OTEL stdout (no APM SDK) ─
# Default ON (local ring buffer). Kill switch: BUTLER_V5_TRACE=0
# BUTLER_V5_TRACE=1
# BUTLER_V5_TRACE_REDACT=1
# BUTLER_V5_TRACE_MAX_EVENTS=500
# Opt-in OTEL-ish JSON lines to stderr: BUTLER_V5_OTEL_EXPORTER=stdout
# BUTLER_V5_OTEL_EXPORTER=off
# CLI: butler traces [list|clear]

# ─── Task / Procedure (cross-conversation todos + linear templates) ─
# No DAG. Procedure is immutable; Task fires source=task RunTriggers.
# CLI: butler task list|add|run|done|proc-list|proc-add
# Acceptance: pnpm test:p4-acceptance (模拟微信 inbound，无真 iLink)
# Operator check: butler verify [--api http://127.0.0.1:3000]

# ─── Workspace sandbox (read_file / run_command) ────────
# Defaults to process cwd (systemd WorkingDirectory = butler-v5).
# BUTLER_V5_WORKSPACE_ROOT=/home/ailearn/projects/WFXM
# Narrow bind mount for bubblewrap+slirp run_command (monorepo root can hang/fail):
# BUTLER_V5_SANDBOX_WORKSPACE_ROOT=/home/ailearn/projects/WFXM/butler-v5

# ─── P2 凭证宿主注入 (run_command) ─────────────────────
# 值只由宿主持有并在执行边界注入；模型/审计/context artifact 只见凭证名。
# BUTLER_V5_CREDENTIALS={"REGISTRY_TOKEN":"secret-value"}   # host JSON name→value 仓库
# BUTLER_V5_RUN_COMMAND_CREDENTIALS=REGISTRY_TOKEN,PUBLISH_KEY  # allowlist：run_command 可注入的凭证名
# run_command 请求 credentials:["NAME"] 必须命中 allowlist，否则 fail-closed（值不进 args/context/audit）。

# ─── 微信 ──────────────────────────────────────────────
WECHAT_TOKEN=butler-dev-token
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Native iLink long-poll (v5 talks to Tencent / openclaw-mock; no v4 forward).
# Off by default. Requires WECHAT_TOKEN. After enable, restart butler-v5-gateway.
# BUTLER_V5_ILINK_ENABLED=0
# WECHAT_ACCOUNT_ID=
# WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
# Mock: WECHAT_BASE_URL=http://127.0.0.1:9999
# V5_INBOUND_URL=http://127.0.0.1:3000/v1/wechat/inbound

# ─── Slack (D2.4 step 2 — Channel Port second impl) ─────────
# Socket Mode (recommended; no public webhook endpoint needed).
# OAuth: https://api.slack.com/apps → Bot Token Scopes: chat:write,
# im:write, im:history, im:read, users:read. Subscribe to message.im.
# BUTLER_V5_SLACK_ENABLED=0
# BUTLER_V5_SLACK_BOT_TOKEN=xoxb-REPLACE-ME
# BUTLER_V5_SLACK_APP_TOKEN=xapp-REPLACE-ME
# BUTLER_V5_SLACK_OWNER_USER_ID=U-REPLACE-ME
# BUTLER_V5_ILINK_INBOUND_TIMEOUT_MS=180000
# WECHAT_DM_POLICY=open
# WECHAT_ALLOWED_USERS=
# BUTLER_OWNER_WECHAT_ID=
# WECHAT_GROUP_POLICY=disabled
# WECHAT_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
# Inbound download + outbound send_wechat_file share this cap (default 8MiB).
# WECHAT_MEDIA_MAX_BYTES=8388608
# BUTLER_V5_ILINK_SYNC_BUF_PATH=
# QR re-login: pnpm --filter @butler/cli exec tsx src/index.ts wechat-login
