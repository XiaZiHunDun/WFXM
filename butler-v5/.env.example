# Butler v5 Environment Variables
# Copy to .env and customize

# ─── Loop 配置 ─────────────────────────────────────────
LOOP_MAX_ITERATIONS=50
LOOP_TIMEOUT_MS=600000

# ─── Guard 配置 ────────────────────────────────────────
GUARDS_OWNER_OFFLINE_THRESHOLD_MS=300000
GUARDS_CHAOS_ENABLED=false

# ─── LLM 配置 ──────────────────────────────────────────
LLM_PRIMARY=anthropic
LLM_FALLBACK=openai

# ─── 数据库 ────────────────────────────────────────────
# Production (`NODE_ENV=production` + DATABASE_URL) uses Docker Postgres so
# conversation events survive gateway restart. Tests stay on in-process PGlite.
# Override: BUTLER_V5_DB=pglite | postgres
DATABASE_URL=postgres://butler:butler_dev@localhost:5432/butler_v5
# BUTLER_V5_DB=postgres
DB_MAX_CONNECTIONS=10

# ─── Target runtime / governance ───────────────────────
# Read model: event_store | hybrid | relational (default event_store)
# BUTLER_V5_READ_MODEL=event_store
# Owner loopback API bearer token (required for /v1/owner/* and `butler approvals`)
# BUTLER_V5_OWNER_TOKEN=
# Sandbox for run_command: unset | bubblewrap (fail-closed when bwrap missing)
# BUTLER_V5_SANDBOX=bubblewrap

# ─── MCP (opt-in, default off) ─────────────────────────
# BUTLER_V5_MCP_ENABLED=0
# Stub tool names when no MCP server URL wired yet (comma-separated)
# BUTLER_V5_MCP_TOOL_NAMES=search,fetch
# BUTLER_V5_MCP_URL=http://127.0.0.1:7777/mcp
# BUTLER_V5_MCP_TOKEN=
# BUTLER_V5_MCP_TIMEOUT_MS=30000
# BUTLER_V5_MCP_REQUIRED=0
# BUTLER_V5_GRANT_NETWORK_HOSTS=

# BUTLER_V5_MCP_TRANSPORT=http
# BUTLER_V5_MCP_COMMAND=node
# BUTLER_V5_MCP_ARGS=path/to/mcp-server.js

# ─── Generic channel intake (opt-in second channel seam) ─
# BUTLER_V5_CHANNEL_API_ENABLED=0
# BUTLER_V5_CHANNEL_ALLOWLIST=slack,telegram,api
# BUTLER_V5_SLACK_ENABLED=0
# BUTLER_V5_SLACK_SIGNING_SECRET=
# BUTLER_V5_SLACK_BOT_TOKEN=
# BUTLER_V5_TELEGRAM_ENABLED=0
# BUTLER_V5_TELEGRAM_WEBHOOK_SECRET=
# BUTLER_V5_TELEGRAM_BOT_TOKEN=

# ─── Workspace sandbox (read_file / run_command) ────────
# Defaults to process cwd (systemd WorkingDirectory = butler-v5).
# BUTLER_V5_WORKSPACE_ROOT=/home/ailearn/projects/WFXM

# ─── 微信 ──────────────────────────────────────────────
WECHAT_TOKEN=butler-dev-token
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Native iLink long-poll (v5 talks to Tencent / openclaw-mock; no v4 forward).
# Off by default. Requires WECHAT_TOKEN. After enable, restart butler-v5-gateway.
# BUTLER_V5_ILINK_ENABLED=0
# WECHAT_ACCOUNT_ID=
# WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
# Mock: WECHAT_BASE_URL=http://127.0.0.1:9999
# V5_INBOUND_URL=http://127.0.0.1:3000/v1/wechat/inbound
# BUTLER_V5_ILINK_INBOUND_TIMEOUT_MS=180000
# WECHAT_DM_POLICY=open
# WECHAT_ALLOWED_USERS=
# BUTLER_OWNER_WECHAT_ID=
# WECHAT_GROUP_POLICY=disabled
# WECHAT_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
# Inbound download + outbound send_wechat_file share this cap (default 8MiB).
# WECHAT_MEDIA_MAX_BYTES=8388608
# BUTLER_V5_ILINK_SYNC_BUF_PATH=
# QR re-login: pnpm --filter @butler/cli exec tsx src/index.ts wechat-login
