{
  "name": "butler-v5",
  "version": "0.0.1",
  "private": true,
  "description": "Butler v5 — 函数式架构微信编码管家（TypeScript + Effect-TS）",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest run",
    "test:archived": "vitest run --config vitest.archived.config.ts",
    "test:p4-acceptance": "bash scripts/p4-acceptance.sh",
    "record:real-llm": "tsx scripts/acceptance/record-real-llm.ts",
    "smoke:multi-project": "node scripts/cutover/smoke-multi-project.mjs",
    "smoke:wechat-context": "node scripts/cutover/smoke-wechat-context.mjs",
    "smoke:schedule": "node scripts/cutover/smoke-schedule.mjs",
    "smoke:durable-memory": "node scripts/cutover/smoke-durable-memory.mjs",
    "smoke:document-ingest": "node scripts/cutover/smoke-document-ingest.mjs",
    "smoke:sandbox": "tsx cli/src/index.ts sandbox-preflight",
    "smoke:sandbox-network": "tsx cli/src/index.ts sandbox-probe",
    "smoke:sandbox-allowlist": "tsx cli/src/index.ts sandbox-probe-allowlist",
    "smoke:allowlist-production": "node scripts/cutover/smoke-allowlist-production.mjs",
    "smoke:allowlist-pnpm": "node scripts/cutover/smoke-allowlist-production.mjs --pnpm",
    "smoke:allowlist-slirp": "node scripts/cutover/smoke-allowlist-production.mjs --slirp",
    "smoke:allowlist-owner": "node scripts/cutover/smoke-wechat-allowlist-owner.mjs",
    "smoke:scheme-b-allowlist": "node scripts/cutover/smoke-scheme-b-delegate-allowlist.mjs",
    "smoke:mcp": "node scripts/cutover/smoke-mcp-hardened.mjs",
    "smoke:project-surface": "node scripts/cutover/smoke-wechat-project-surface.mjs",
    "smoke:wechat-commands": "node scripts/cutover/smoke-wechat-inbound-commands.mjs",
    "smoke:dev-tools": "node scripts/cutover/smoke-wechat-dev-tools.mjs",
    "smoke:prod-tune": "node scripts/cutover/smoke-wechat-prod-tune.mjs",
    "smoke:product-contract": "node scripts/cutover/smoke-wechat-product-contract.mjs",
    "smoke:productivity": "node scripts/cutover/smoke-wechat-productivity.mjs",
    "smoke:notify-acceptance": "node scripts/cutover/smoke-wechat-notify-acceptance.mjs",
    "smoke:regression": "node scripts/cutover/smoke-regression.mjs",
    "smoke:regression:quick": "node scripts/cutover/smoke-regression.mjs --quick",
    "smoke:ilink": "node scripts/cutover/smoke-ilink-connectivity.mjs",
    "smoke:ci-regression": "bash scripts/cutover/ci-smoke-regression.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run -- --reporter=verbose",
    "lint": "eslint packages/ apps/ tests/ --ext .ts --max-warnings 0",
    "lint:fix": "eslint packages/ apps/ tests/ --ext .ts --fix",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "deadcode": "ts-prune packages/ apps/ --error 2>&1 || true",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules dist coverage",
    "gate": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test -- --coverage && bash scripts/typecheck-gate.sh",
    "postinstall": "bash ../scripts/ai_guard/install-pre-commit-hook.sh"
  },
  "devDependencies": {
    "@ivotoby/openapi-mcp-server": "^1.16.1",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "firecrawl-mcp": "^3.24.0",
    "prettier": "^3.3.0",
    "ts-prune": "^0.10.3",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@effect/schema": "^0.66.0",
    "drizzle-orm": "^0.33.0",
    "effect": "^3.4.0",
    "postgres": "^3.4.0"
  }
}
