# per-project spec/framework directory (memory: ".butler/ 整目录 gitignore")
.butler/

# local superpowers planning notes (not product docs)
docs/superpowers/plans/
tests/acceptance/scenarios/recordings/
# Per-version baseline snapshots: ignore *.json inside each version subdir
# (real LLM output + apiKeyMask). Each subdir's README.md is tracked so
# the index survives across sandboxes. See
# tests/acceptance/scenarios/recordings-archive/README.md
tests/acceptance/scenarios/recordings-archive/*
!tests/acceptance/scenarios/recordings-archive/README.md
!tests/acceptance/scenarios/recordings-archive/*/
# re-ignore subdir contents: `!*/` above un-ignores the dirs themselves, which
# would otherwise leave each subdir's *.json untracked-but-not-ignored.
tests/acceptance/scenarios/recordings-archive/*/*
!tests/acceptance/scenarios/recordings-archive/*/README.md

